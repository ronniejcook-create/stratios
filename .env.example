# Stratios private settings.
# Copy this file to .env.local (keys.bat does this for you on Windows).
# .env.local stays on your computer; it is never sent to GitHub.

# 1. Paste the two lines from Clerk (https://dashboard.clerk.com -> API keys)
#    directly below this line, then save. They look like:
#    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#    CLERK_SECRET_KEY=sk_test_...


# 2. Leave these as they are.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# 3. Optional: Anthropic API key (https://console.anthropic.com) used to pick each
#    organization's brand colors from its website. Without it, every organization
#    uses the Stratios colors.
ANTHROPIC_API_KEY=
# Only if the key is not tied to a workspace: the workspace ID from the Console.
ANTHROPIC_WORKSPACE_ID=

# 4. Postgres connection string. Use a role WITHOUT the BYPASSRLS attribute
#    so row-level security applies (see README).
DATABASE_URL=

# 5. Optional: the ID of the Stratios organization (org_...), whose administrators
#    manage the Master Library. Not needed when that organization's company domain
#    is recorded as stratios.app in the database (migration 006 does this).
STRATIOS_ORG_ID=

# Optional. Address suggestions while typing (Google Places API (New)).
# Without it, Add Address still works with the type-then-find lookup.
# Create the key in Google Cloud and restrict it to "Places API (New)".
GOOGLE_MAPS_API_KEY=
